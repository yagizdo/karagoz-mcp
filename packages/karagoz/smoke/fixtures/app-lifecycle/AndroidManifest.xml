<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.karagoz.smoke">
  <application android:hasCode="false" android:label="karagoz smoke">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="karagoz-smoke" />
      </intent-filter>
    </activity>
  </application>
</manifest>
