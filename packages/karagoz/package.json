{
  "name": "karagoz",
  "version": "0.0.0",
  "license": "MIT",
  "homepage": "https://karagozmcp.com",
  "type": "module",
  "bin": {
    "karagoz": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --splitting --outdir=dist && node -e \"require('fs').copyFileSync('src/drivers/ios/ax-helper.swift','dist/ax-helper.swift')\"",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\"",
    "typecheck": "tsc",
    "lint": "oxlint src && prettier --check src",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  }
}
